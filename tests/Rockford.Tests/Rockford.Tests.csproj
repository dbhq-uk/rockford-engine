<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.10.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rockford.Engine\Rockford.Engine.csproj" />
    <ProjectReference Include="..\..\src\Rockford.Formats\Rockford.Formats.csproj" />
    <ProjectReference Include="..\..\src\Rockford.Reference\Rockford.Reference.csproj" />

    <!-- For the StatusBar component only. bUnit renders it with no browser, no JS
         module and no HTTP, which is why it is its own component. -->
    <ProjectReference Include="..\..\web\Rockford.Web\Rockford.Web.csproj" />
  </ItemGroup>

</Project>