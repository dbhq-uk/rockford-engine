<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- THE CONTENT OF wwwroot BECOMES THE CACHE KEY, for game.js and for every
         asset URL the application builds. See Home.razor and tools/contentid.py.

         This was the build TIME - `1.0.<day-of-year>.<HHmm>` - which is wrong in
         both directions: two builds made inside the same minute were
         indistinguishable to a browser, and two builds of identical content
         made an hour apart needlessly were not.

         Overridable, and scripts/assemble-site.sh passes the real value. The
         fallback keeps `dotnet build` working on its own without shelling out
         to python from MSBuild, at the cost of being a clock again - which is
         only ever seen by a developer on localhost, never by a release. -->
    <Version Condition="'$(Version)' == ''">1.0.$([System.DateTime]::UtcNow.DayOfYear).$([System.DateTime]::UtcNow.ToString(`HHmm`))</Version>

    <!-- Which version this build is: Faithful or Vip.

         A build-time choice rather than a switch in the page, because these are
         two releases and not two settings. A toggle would mean every faithful
         build still shipped the enhanced assets, and "faithful" would quietly
         become "faithful, with an option". One codebase, one engine, two
         releases: dotnet publish -p:Presentation=Vip -->
    <Presentation Condition="'$(Presentation)' == ''">Faithful</Presentation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Presentation)' == 'Vip'">
    <DefineConstants>$(DefineConstants);VIP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rockford.Engine\Rockford.Engine.csproj" />
    <ProjectReference Include="..\..\src\Rockford.Formats\Rockford.Formats.csproj" />
  </ItemGroup>

</Project>
